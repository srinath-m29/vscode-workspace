# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Session Security (Generate a random 32+ character string)
SESSION_SECRET=

# Two-User Allowlist (Numeric GitHub IDs preferred, or usernames)
ALLOWED_GITHUB_USER_1=
ALLOWED_GITHUB_USER_2=

# Runtime Environment (development | production)
ENVIRONMENT=development

# Render API Deployment Configuration (Step 12)
# Server-side only: never exposed to browser or logs
RENDER_API_KEY=
# Mapping of GitHub repositories to Render services:
# JSON format: {"owner/repo": "srv-xxxxxxxxxxxxxxxxxxxx"}
# or comma-separated: owner/repo:srv-xxx,owner2/repo2:srv-yyy
RENDER_SERVICE_MAP={}

