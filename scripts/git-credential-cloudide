#!/usr/bin/env python3
"""
Cloud IDE - Ephemeral Git Credential Helper and GIT_ASKPASS script.
Installed at /usr/local/bin/git-credential-cloudide.

Requirements:
- Executable, minimal, standard library only.
- No hardcoded tokens, no persistent token storage, no logging.
- Supports both GIT_ASKPASS mode and Git credential protocol (get, store, erase).
- Only responds for github.com.
- Ephemerally retrieves the authenticated user's GitHub token via backend loopback.
"""

import sys
import os
import json
import urllib.request
import urllib.error
import subprocess


def get_git_info():
    """Detects repository root and origin remote URL."""
    repo_root = ""
    remote_url = ""
    try:
        proc_root = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if proc_root.returncode == 0:
            repo_root = proc_root.stdout.strip()
    except Exception:
        repo_root = os.getcwd()

    if not repo_root:
        repo_root = os.getcwd()

    try:
        proc_remote = subprocess.run(
            ["git", "config", "--get", "remote.origin.url"],
            cwd=repo_root,
            capture_output=True,
            text=True,
            timeout=5,
        )
        if proc_remote.returncode == 0:
            remote_url = proc_remote.stdout.strip()
    except Exception:
        remote_url = ""

    return repo_root, remote_url


def fetch_credential_from_backend(repo_root, remote_url):
    """
    Requests ephemeral credential from server-side loopback endpoint.
    Returns (username, token) on success, or (None, None) on failure.
    """
    # 1. Look for workspace session key
    workspace_key = os.environ.get("CLOUDIDE_WORKSPACE_KEY")
    if not workspace_key and repo_root:
        key_file = os.path.join(repo_root, ".git", "cloudide_key")
        if os.path.isfile(key_file):
            try:
                with open(key_file, "r", encoding="utf-8") as f:
                    workspace_key = f.read().strip()
            except Exception:
                workspace_key = None

    backend_url = os.environ.get("CLOUDIDE_BACKEND_URL", "http://127.0.0.1:8000")
    endpoint = f"{backend_url.rstrip('/')}/api/git/credential"

    payload = json.dumps({
        "workspace_path": repo_root,
        "remote_url": remote_url,
        "workspace_key": workspace_key,
    }).encode("utf-8")

    req = urllib.request.Request(
        endpoint,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                return data.get("username", "x-access-token"), data.get("token", "")
    except urllib.error.HTTPError as e:
        # Avoid leaking details on stdout/stderr
        sys.exit(1)
    except Exception:
        sys.exit(1)

    return None, None


def handle_askpass(prompt):
    """Handles GIT_ASKPASS invocation."""
    if "Username" in prompt:
        print("x-access-token")
        sys.exit(0)
    elif "Password" in prompt:
        repo_root, remote_url = get_git_info()
        username, token = fetch_credential_from_backend(repo_root, remote_url)
        if token:
            print(token)
            sys.exit(0)
        sys.exit(1)
    else:
        print("")
        sys.exit(0)


def handle_credential_helper(action):
    """Handles Git credential helper protocol: get, store, erase."""
    if action in ("store", "erase"):
        # We never persist or cache credentials on disk.
        sys.exit(0)

    if action == "get":
        # Read key=value pairs from stdin until empty line or EOF
        stdin_data = {}
        for line in sys.stdin:
            line = line.strip()
            if not line:
                break
            if "=" in line:
                k, v = line.split("=", 1)
                stdin_data[k.strip()] = v.strip()

        # Enforce github.com host check
        host = stdin_data.get("host", "").lower()
        if host and host != "github.com":
            # Reject non-GitHub hosts
            sys.exit(0)

        repo_root, remote_url = get_git_info()
        if not remote_url and stdin_data.get("path"):
            path = stdin_data["path"].lstrip("/")
            remote_url = f"https://github.com/{path}"

        username, token = fetch_credential_from_backend(repo_root, remote_url)
        if token:
            print(f"username={username or 'x-access-token'}")
            print(f"password={token}")
            sys.exit(0)
        sys.exit(1)

    sys.exit(0)


def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg in ("get", "store", "erase"):
            handle_credential_helper(arg)
        else:
            # Treated as GIT_ASKPASS prompt
            handle_askpass(arg)
    else:
        # Default to credential helper 'get' if called without args
        handle_credential_helper("get")


if __name__ == "__main__":
    main()
